# ─── 자격증명 — 이 저장소는 공개다 ─────────────────────────────────────────
# 실기 값은 각 기계 로컬에만 둔다. *.example 만 커밋한다.
firmware/**/pump_secrets.h
firmware/**/mosquitto_local.conf
firmware/**/mosquitto_passwd
.env*
*.env
!*.env.example

# ─── 플래시 이미지 ──────────────────────────────────────────────────────────
# 4 MB 전체 덤프에는 NVS 의 WiFi·MQTT 자격증명이 박혀 있다. 절대 커밋하지 않는다.
*.bin
*.app

# ─── 빌드 산출물 ────────────────────────────────────────────────────────────
build/
build_out/
.dart_tool/

# ─── 파이썬 ────────────────────────────────────────────────────────────────
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.worktrees/

# ─── 편집기·OS·도구 ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.omc/
.claude/
.superpowers/
